{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "Lumo JARVIS",
  "version": "0.1.0",
  "identifier": "com.lumoryxr.jarvis",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Lumo JARVIS",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "fullscreen": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": null,
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "active": true,
      "dialog": true,
      "endpoints": [
        "https://github.com/lumoryxr/lumo-jarvis/releases/latest/download/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}